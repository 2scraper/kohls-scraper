# kohls-scraper — credentials and defaults
#
# Copy this file to `.env` next to the scripts and fill in what you use:
#
#     cp .env.example .env
#
# `.env` is in .gitignore (and so is every `.env*` variant except this file).
# Keep it there. A secret passed on a command line is readable by anything
# that can run `ps` and lands in your shell history, which is why none of
# these has a flag you are expected to type.
#
# Precedence, highest first:
#
#     explicit CLI flag  >  exported environment variable  >  .env  >  default
#
# Check what was picked up, without printing any secret:
#
#     python3 env_config.py
#
# Every variable below is one this code actually reads, and every variable
# the code reads is below — smoke_test.py asserts the two sets are equal in
# both directions.


# --- 2Captcha -------------------------------------------------------------
# One key, four separately-billed products: captcha solving, the Scraping
# Browser API, proxies and fingerprints. https://2captcha.com
TWOCAPTCHA_KEY=your_2captcha_api_key_here

# --- Scraping Browser API -------------------------------------------------
# A remote browser you do not run or patch, with a persistent profile and a
# chosen exit country. Used by --cdp-endpoint. Profiles expire (about a day),
# so this is the SHAPE of the endpoint, never a working one.
#
#   country-  the exit country. kohls.com is a US shop.
#   pid-      a profile with persistent cookies. ONE live connection each.
#
# Selenium cannot use this: chromedriver's `debuggerAddress` takes a bare
# host:port with nowhere to put a password.
KOHLS_CDP_ENDPOINT=ws://{login}-zone-scraping_browser-country-us-pid-{profileId}:{password}@cb.2captcha.com:9222

# --- Proxy ----------------------------------------------------------------
# The gateway host is the same for every exit country; the COUNTRY is a
# segment of the login (`-country-us` / `-region-…`), copied from the
# 2captcha.com proxy dashboard. One URL; for a pool, use --proxy-file with
# one per line. The credentials never reach the browser's command line —
# Playwright and pyppeteer pass them through their own authentication; the
# Selenium engine cannot authenticate a proxy at all and strips them, with a
# warning. Logs keep host:port and mask the rest.
KOHLS_PROXY=http://{user}:{password}@eu.proxy.2captcha.com:2334

# --- Default target -------------------------------------------------------
# Saves retyping --url.
KOHLS_URL=https://www.kohls.com/catalog/womens-clothing.jsp?CN=Gender:Womens+Department:Clothing

# Deliberately NOT here: an output prefix. `--out` already carries a
# non-empty default, so the loader — which only fills UNSET values — would
# never see it, and the variable would be silently inert.
